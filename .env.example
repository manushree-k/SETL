# Copy to .env.local and fill values. Never commit .env.local.
# All four are required at runtime (except LLM_* when LLM_ENABLED=false).

# Postgres — Neon free tier example:
#   postgresql://user:pass@ep-xxx.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://user:pass@host/db?sslmode=require

# LLM toggle — must be "true" or "false" (case-insensitive)
LLM_ENABLED=false

# Required only when LLM_ENABLED=true — Anthropic example:
LLM_MODEL=claude-3-5-haiku-20241022
LLM_API_KEY=sk-ant-...

# For local offline evaluate with no DB, you only need:
#   LLM_ENABLED=false
# No DATABASE_URL required for `npm run evaluate`.
